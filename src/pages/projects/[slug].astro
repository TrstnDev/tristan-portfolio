---
import Layout from "../../layouts/Layout.astro";
import { projects, type Project } from "../../data/portfolio";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Layout title={project.title} description={project.summary}>
  <main id="main" class="shell case-study">
    <a class="text-link" href="/#work">← All projects</a>

    <header class="case-header">
      <p class="eyebrow" data-hero>
        {project.number} / {project.category}
      </p>
      <h1 data-hero>{project.title}</h1>
      <p class="case-summary" data-hero>{project.summary}</p>
    </header>

    {project.image && (
      <img
        class="case-image"
        src={project.image.src}
        alt={project.image.alt}
        width="1200"
        height="750"
      />
    )}

    <section class="prose section" data-reveal>
      <p class="eyebrow">Context</p>
      <p>{project.context}</p>

      <h2>My role</h2>
      <p>{project.role}</p>

      <h2>What I contributed</h2>
      <ul>
        {project.contributions.map((item) => <li>{item}</li>)}
      </ul>

      <h2>Technologies</h2>
      <ul class="tags" aria-label="Technologies used">
        {project.technologies.map((item) => <li>{item}</li>)}
      </ul>

      <div class="link-row">
        {project.repository && (
          <a href={project.repository}>View source ↗</a>
        )}
        {project.demo && (
          <a href={project.demo}>Open demonstration ↗</a>
        )}
      </div>
    </section>
  </main>
</Layout>