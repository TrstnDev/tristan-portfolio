---
import Layout from "../layouts/Layout.astro";
import { profile, projects } from "../data/portfolio";
---

<Layout title="Software development and design">
  <main id="main" class="shell">
    <section class="hero">
      <div>
        <p class="eyebrow" data-hero>
          Portfolio / Application Development
        </p>

        <h1 data-hero>{profile.name}</h1>

        <p class="hero-intro" data-hero>{profile.introduction}</p>

        <a class="text-link" href="#work" data-hero>
          Explore selected work ↓
        </a>
      </div>

      <aside class="hero-panel" data-hero aria-label="Areas of interest">
        <p class="eyebrow">Working across</p>
        <ol>
          <li><span>01</span> Software development</li>
          <li><span>02</span> Interface design</li>
          <li><span>03</span> Network systems</li>
        </ol>
        <p class="small">{profile.location}</p>
      </aside>
    </section>

    <section id="work" class="section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Index / 01—04</p>
          <h2>Selected work</h2>
        </div>
        <p class="small">Academic projects and explorations</p>
      </div>

      <div class="project-grid">
        {projects.map((project) => (
          <a
            class:list={["project-card", project.tone]}
            href={`/projects/${project.slug}/`}
            data-reveal
          >
            {project.image ? (
              <img
                class="project-image"
                src={project.image.src}
                alt={project.image.alt}
                width="1200"
                height="750"
                loading="lazy"
              />
            ) : (
              <div class="project-art" aria-hidden="true">
                <span>{project.number}</span>
              </div>
            )}

            <div class="card-meta">
              <span>{project.number} / {project.category}</span>
              <span aria-hidden="true">↗</span>
            </div>

            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <p class="small">{project.technologies.join(" / ")}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="about" class="about section" data-reveal>
      <p class="eyebrow">Background / Approach</p>
      <h2>I enjoy the decisions behind the interface.</h2>
      <p>
        I’m studying Application Development at The IIE’s Emeris,
        with expected completion in December 2027. My work connects
        C#/.NET implementation with requirements analysis,
        interface design and clear technical documentation.
      </p>
      <p>
        I’m interested in paid development opportunities where I can
        contribute to useful features, thoughtful interfaces,
        testing and practical problem-solving.
      </p>
    </section>
  </main>
</Layout>
